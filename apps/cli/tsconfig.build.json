{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // Type-check/emit into a private directory, not `dist` - `dist` is
    // reserved for the bundled, publishable CLI artifact (see scripts/bundle.mjs).
    "outDir": ".tsbuild",
    "tsBuildInfoFile": ".tsbuild/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts"],
  "references": [
    { "path": "../../packages/shared/tsconfig.build.json" },
    { "path": "../../packages/core/tsconfig.build.json" },
    { "path": "../../packages/adapters/tsconfig.build.json" },
    { "path": "../../packages/audit/tsconfig.build.json" },
    { "path": "../../packages/git/tsconfig.build.json" },
    { "path": "../../packages/mcp-server/tsconfig.build.json" },
    { "path": "../../packages/shield/tsconfig.build.json" }
  ]
}
