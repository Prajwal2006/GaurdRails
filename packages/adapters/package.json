{
  "name": "@guardrails/adapters",
  "version": "0.1.0",
  "description": "Thin adapters that translate AI coding tools (Claude Code, Codex, Copilot, Gemini, Cursor, Windsurf) to Guardrails' neutral request/response shape.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@guardrails/shared": "workspace:*"
  }
}
