{
  "name": "@guardrails/mcp-server",
  "version": "0.1.0",
  "description": "A Model Context Protocol server that mediates AI file access through Guardrails, exposing only approved files with audit logging.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@guardrails/adapters": "workspace:*",
    "@guardrails/audit": "workspace:*",
    "@guardrails/core": "workspace:*",
    "@guardrails/policy-engine": "workspace:*",
    "@guardrails/shared": "workspace:*"
  }
}
