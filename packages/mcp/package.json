{
  "name": "@guardrails/mcp",
  "version": "0.1.0",
  "description": "A guarded MCP file server that exposes only approved files to AI tools, redacting or denying the rest.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@guardrails/core": "workspace:*",
    "@guardrails/shared": "workspace:*"
  }
}
