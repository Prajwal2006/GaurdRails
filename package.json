{
	"name": "guardrails-cli",
	"version": "0.1.0",
	"private": true,
	"description": "Guardrails - an AI Security Layer that keeps secrets away from AI coding assistants. Privacy-first, local-only.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.33.0",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "pnpm --filter ./apps/cli run build",
		"dev": "pnpm --filter ./apps/cli run dev",
		"install-cli": "pnpm run build && node scripts/install-global.mjs",
		"uninstall-cli": "node scripts/install-global.mjs --remove",
		"typecheck": "tsc -b",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"clean": "pnpm -r exec rm -rf dist .tsbuild .turbo node_modules/.cache",
		"check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
		"pack:cli": "pnpm --filter ./apps/cli exec npm pack",
		"publish:cli": "pnpm --filter ./apps/cli publish --access public"
	},
	"dependencies": {
		"@guardrails/secret-detector": "workspace:*",
		"@guardrails/shared": "workspace:*"
	},
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"@types/node": "^22.10.5",
		"@typescript-eslint/eslint-plugin": "^8.19.1",
		"@typescript-eslint/parser": "^8.19.1",
		"@vitest/coverage-v8": "^3.2.6",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"prettier": "^3.4.2",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.19.1",
		"vitest": "^3.2.6"
	}
}